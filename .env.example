# Local development defaults only. Do not use these values in production.

POSTGRES_DB=infranex_dev
POSTGRES_USER=infranex_dev
POSTGRES_PASSWORD=infranex_dev_password
POSTGRES_PORT=5432

DATABASE_URL=postgresql://infranex_dev:infranex_dev_password@localhost:5432/infranex_dev?schema=public
REDIS_URL=redis://localhost:6379

MINIO_ENDPOINT=http://localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=infranex_minio
MINIO_SECRET_KEY=infranex_minio_password
MINIO_BUCKET=infranex-dev

JWT_SECRET=replace-with-local-jwt-secret
JWT_REFRESH_SECRET=replace-with-local-refresh-secret
NEXTAUTH_SECRET=replace-with-local-nextauth-secret
NEXTAUTH_URL=http://localhost:3000
API_CORS_ORIGIN=http://localhost:3000

OPENAI_API_KEY=replace-with-openai-api-key
SERPER_API_KEY=replace-with-serper-api-key
SENDGRID_API_KEY=replace-with-sendgrid-api-key
EMAIL_ENCRYPTION_KEY=replace-with-32-byte-email-encryption-key
SENTRY_DSN=
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key

NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001/realtime

GCP_PUBSUB_PROJECT=replace-with-gcp-project
GCP_PUBSUB_TOPIC=replace-with-pubsub-topic
